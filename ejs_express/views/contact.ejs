<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Admin</title>
    <link rel="stylesheet" href="/css/stylecontact.css">
</head>
<body>
    <header>
        <h1>Contact the Admin</h1>
    </header>

    <% if (!showInfo) { %>
        <div class="captcha-form">
            <p>Before showing my contact info, please verify you are not a robot:</p>
            <% if (typeof error !== 'undefined') { %>
                <p class="error"><%= error %></p>
            <% } %>

            <form method="POST" action="/contact">
                <div class="question">
                    <label>1) Select the picture of shamsu real:</label>
                    <div class="options">
                        <label><input type="radio" name="q1" value="pic1" required> <img src="/images/shamsu.jpg" alt="Option 1"></label>
                        <label><input type="radio" name="q1" value="pic2"> <img src="/images/shamsu2.jpg" alt="Option 2"></label>
                        <label><input type="radio" name="q1" value="pic3"> <img src="/images/shamsu3.jpg" alt="Option 3"></label>
                    </div>
                </div>

                <div class="question">
                    <label>2) Select the picture of shamsu as a cat:</label>
                    <div class="options">
                        <label><input type="radio" name="q2" value="pic1" required> <img src="/images/shamsu.jpg" alt="Option 1"></label>
                        <label><input type="radio" name="q2" value="pic2"> <img src="/images/shamsu2.jpg" alt="Option 2"></label>
                        <label><input type="radio" name="q2" value="pic3"> <img src="/images/shamsu3.jpg" alt="Option 3"></label>
                    </div>
                </div>

                <div class="question">
                    <label>3) Select the picture of fool:</label>
                    <div class="options">
                        <label><input type="radio" name="q3" value="pic1" required> <img src="/images/shamsu.jpg" alt="Option 1"></label>
                        <label><input type="radio" name="q3" value="pic2"> <img src="/images/shamsu2.jpg" alt="Option 2"></label>
                        <label><input type="radio" name="q3" value="pic3"> <img src="/images/shamsu3.jpg" alt="Option 3"></label>
                    </div>
                </div>

                <button type="submit">Submit</button>
            </form>
        </div>
    <% } else { %>
        <div class="contact-info">
            <h2>Contact Information</h2>
            <p>Email: admin@example.com</p>
            <p>Phone: +123 456 7890</p>
            <p>Address: 123 Main Street, City, Country</p>
        </div>
    <% } %>
</body>
</html>
